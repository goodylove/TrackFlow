NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/trackflow
JWT_SECRET=replace-with-a-long-random-secret
# Exact frontend origin without a trailing slash or path. HTTPS is required in production.
CLIENT_ORIGIN=http://localhost:5173
# Use none only for genuinely cross-site HTTPS hosting; see docs/api.md.
COOKIE_SAME_SITE=lax
